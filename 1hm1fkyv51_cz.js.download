@import url('https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&display=swap');
@keyframes gravity-lf-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes gravity-lf-pop {
  from { opacity: 0; transform: translateY(8px) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
.gravity-lf-input:focus {
  border-bottom-color: var(--gravity-leadform-accent, ${C}) !important;
  background: var(--gravity-leadform-input-focus-bg, transparent) !important;
}
.gravity-lf-input::placeholder {
  color: #d4d4d4;
}
.gravity-lf-submit:hover,
.gravity-lf-trigger-cta:hover {
  background: var(--gravity-leadform-accent-hover, #000000) !important;
}
.gravity-lf-close:hover {
  background: ${O} !important;
  color: ${k} !important;
}
