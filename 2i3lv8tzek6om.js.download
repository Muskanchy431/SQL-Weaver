}

const server = http.createServer((req, res) => {
  const routed = route(req.url);
  if (!routed) return notFound(res);
  if (routed.redirect) {
    res.writeHead(302, { Location: routed.redirect, 'Cache-Control': 'no-store', 'Referrer-Policy': 'no-referrer' });
    return res.end();
  }
  if (service === 'terminal') {
    const q = routed.target.indexOf('?');
    const targetPath = q < 0 ? routed.target : routed.target.slice(0, q);
    if (targetPath.indexOf(TTY_PATH) === 0) return handleTty(req, res, routed.target);
    if (targetPath === '/' && req.method === 'GET') return serveTerminalIndex(req, res, routed.target);
  }
  const upstream = http.request({ socketPath, method: req.method, path: routed.target, headers: forwardHeaders(req.rawHeaders) }, (upRes) => {
    const headers = Object.assign({}, upRes.headers);
    // The page URL carries the token; never let it leave in a Referer.
    headers['referrer-policy'] = 'no-referrer';
    res.writeHead(upRes.statusCode || 502, headers);
    upRes.pipe(res);
  });
  upstream.on('error', () => {
    if (!res.headersSent) { res.writeHead(502, { 'Content-Type': 'text/plain' }); res.end('Bad gateway'); }
    else res.destroy();
  });
  req.pipe(upstream);
});

server.on('upgrade', (req, socket, head) => {
  socket.on('error', () => socket.destroy());
  const routed = route(req.url);
  if (!routed || !routed.target) {
    socket.end('HTTP/1.1 404 Not Found\r\nConnection: close\r\nContent-Length: 0\r\n\r\n');
    return;
  }
  const upstream = net.connect(socketPath, () => {
    const headers = forwardHeaders(req.rawHeaders);
    const lines = [req.method + ' ' + routed.target + ' HTTP/' + req.httpVersion];
    for (let i = 0; i + 1 < headers.length; i += 2) lines.push(headers[i] + ': ' + headers[i + 1]);
    upstream.write(lines.join('\r\n') + '\r\n\r\n');
    if (head && head.length) upstream.write(head);
    upstream.pipe(socket);
    socket.pipe(upstream);
  });
  upstream.on('error', () => socket.destroy());
  socket.on('close', () => upstream.destroy());
});

server.on('clientError', (_err, socket) => { try { socket.end('HTTP/1.1 400 Bad Request\r\n\r\n'); } catch (_) {} });
// Long-lived editor/terminal traffic: no whole-request deadline.
server.requestTimeout = 0;
server.keepAliveTimeout = 65000;

try { fs.unlinkSync(socketPath); } catch (_) {}
const child = childProcess.spawn(backend[0], backend.slice(1), { stdio: ['ignore', 'inherit', 'inherit'], env: process.env });
try { fs.writeFileSync(socketPath + '.pid', String(child.pid), { mode: 0o600 }); } catch (_) {}
let stopping = false;
function stop(code) {
  if (stopping) return;
  stopping = true;
  try { child.kill('SIGTERM'); } catch (_) {}
  server.close();
  setTimeout(() => process.exit(code), 200).unref();
}
child.on('exit', (code) => { if (!stopping) { console.error('[gateway] ' + service + ' backend exited with ' + code); stop(1); } });
child.on('error', (err) => { console.error('[gateway] ' + service + ' backend failed to start: ' + err.message); stop(1); });
for (const signal of ['SIGTERM', 'SIGINT', 'SIGHUP']) process.on(signal, () => stop(0));

server.on('error', (err) => { console.error('[gateway] listen failed: ' + err.code); stop(1); });
server.listen(port, '0.0.0.0');
