// Freebuff hosted workspace gateway. Generated by
// freebuff/web/codebase-utils/hosted-workspace-gateway.ts - edit it there.
const http = require('http');
const net = require('net');
const fs = require('fs');
const crypto = require('crypto');
const zlib = require('zlib');
const childProcess = require('child_process');

const args = process.argv.slice(2);
const sep = args.indexOf('--');
if (sep < 4) { console.error('usage: gateway <service> <port> <socket> <tokenFile> -- <backend...>'); process.exit(64); }
